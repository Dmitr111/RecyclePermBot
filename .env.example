# Скопируйте этот файл в .env и подставьте свои значения.
# .env в репозиторий не попадает (см. .gitignore).

# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=123456789:your-bot-token-from-botfather

# Ключ Yandex Static API (обязательно)
YANDEX_STATIC_API_KEY=00000000-0000-0000-0000-000000000000

# Ключ API поиска по организациям Яндекса (обязательно)
YANDEX_SEARCH_API_KEY=00000000-0000-0000-0000-000000000000

# Chat ID администратора, которому доступна рассылка (необязательно;
# если не задан, рассылка отключена)
ADMIN_CHAT_ID=123456789
